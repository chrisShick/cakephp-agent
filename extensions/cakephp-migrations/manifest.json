{
  "$schema": "../../schemas/extension-manifest.schema.json",
  "id": "cakephp-migrations",
  "name": "CakePHP Migrations",
  "description": "Schema migration workflows for cakephp/migrations ^4 || ^5 (CakePHP 5).",
  "version": "1.0.0",
  "type": "composer-package",
  "detect": {
    "composer": [
      {
        "package": "cakephp/migrations",
        "constraint": "^4.0 || ^5.0"
      }
    ]
  },
  "requires": {
    "cakephp": "^5.0"
  },
  "dependsOn": [],
  "conflictsWith": [],
  "rules": [
    "rules/*.mdc"
  ],
  "skills": [
    "skills/*"
  ],
  "agents": [],
  "defaultEnabledWhenDetected": true
}
