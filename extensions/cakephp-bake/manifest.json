{
  "$schema": "../../schemas/extension-manifest.schema.json",
  "id": "cakephp-bake",
  "name": "CakePHP Bake",
  "description": "Scoped Bake awareness for cakephp/bake ^3 \u2014 generate then edit; never assume Bake is present.",
  "version": "1.0.0",
  "type": "composer-package",
  "detect": {
    "composer": [
      {
        "package": "cakephp/bake",
        "constraint": "^3.0"
      }
    ]
  },
  "requires": {
    "cakephp": "^5.0"
  },
  "dependsOn": [],
  "conflictsWith": [],
  "rules": [
    "rules/*.mdc"
  ],
  "skills": [
    "skills/*"
  ],
  "agents": [],
  "defaultEnabledWhenDetected": true
}
