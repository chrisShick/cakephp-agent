  "requires": {
    "cakephp": "^5.0"
  },
  "dependsOn": [],
  "conflictsWith": [],
  "rules": ["rules/*.mdc"],
  "skills": ["skills/*"],
  "agents": [],
  "defaultEnabledWhenDetected": true
}
