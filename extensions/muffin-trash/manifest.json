{
  "$schema": "../../schemas/extension-manifest.schema.json",
  "id": "muffin-trash",
  "name": "Muffin Trash",
  "description": "Soft-delete guidance for muffin/trash (UseMuffin/Trash) on CakePHP 5.",
  "version": "1.0.0",
  "type": "composer-package",
  "detect": {
    "composer": [
      {
        "package": "muffin/trash",
        "constraint": "^4.0"
      }
    ]
  },
  "requires": {
    "cakephp": "^5.0"
  },
  "dependsOn": [],
  "conflictsWith": [],
  "rules": [
    "rules/*.mdc"
  ],
  "skills": [
    "skills/*"
  ],
  "agents": [],
  "defaultEnabledWhenDetected": true
}
