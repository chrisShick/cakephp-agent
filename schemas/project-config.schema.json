{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cakephp-agent.dev/schemas/project-config.schema.json",
  "title": "CakePHP Agent Project Config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "auto-install": { "type": "boolean" },
    "editor": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "editors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "extensions": {
      "type": "object",
      "properties": {
        "enable": { "type": "array", "items": { "type": "string" } },
        "disable": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
